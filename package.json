{
  "name": "sc-hauler-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Star Citizen hauler mission planner",
  "author": "DrWhite1",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node tests/parseContract.test.mjs && node tests/routeValidity.test.mjs && node tests/containers.test.mjs && node tests/locations.test.mjs && node tests/cargoGrid.test.mjs && node tests/ocrMultiCollect.test.mjs && node --import ./tests/ts-resolve.mjs tests/optimizer.test.mjs",
    "electron:dev": "electron .",
    "electron:build": "next build && electron-builder",
    "dist:win": "next build && electron-builder --win",
    "dist:linux": "next build && electron-builder --linux"
  },
  "build": {
    "appId": "com.drwhite1.schaulerplanner",
    "productName": "SC Hauler Planner",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/arm64/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_{cuda,tensorrt}.so"
    ],
    "win": {
      "target": ["nsis"],
      "icon": null
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@gutenye/ocr-node": "^1.4.9",
    "sharp": "^0.34.3",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0",
    "lucide-react": "^0.460.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "tesseract.js": "^5.1.1",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0"
  }
}